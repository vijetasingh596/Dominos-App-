<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body style="background: #f8fafc;">

  <!-- Global Header -->
  <%- include('partials/header') %>

  <div style="background: #0f172a; color: white; padding: 2.5rem 0;">
    <div class="container">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
          <span style="background: rgba(251,133,0,0.2); color: var(--dominos-gold); border: 1px solid rgba(251,133,0,0.4); padding: 0.3rem 0.75rem; border-radius: 999px; font-size: 0.8rem; font-weight: 800;">STORE OPERATIONS</span>
          <h1 style="font-size: 2.2rem; font-weight: 900; color: white; margin-top: 0.5rem;">Domino's Manager Dashboard</h1>
          <p style="color: #94a3b8;">Manage store kitchen queue, live order progress, and dispatch delivery partners.</p>
        </div>
        <div style="background: rgba(255,255,255,0.08); padding: 0.75rem 1.25rem; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.15);">
          <div style="font-size: 0.8rem; color: #94a3b8;">Store Status</div>
          <div style="font-weight: 800; color: #4ade80;">● ONLINE & ACCEPTING ORDERS</div>
        </div>
      </div>
    </div>
  </div>

  <main class="container" style="padding-top: 2.5rem; padding-bottom: 5rem;">

    <!-- Metrics Row -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
      <div style="background: white; border-radius: var(--radius-md); padding: 1.5rem; border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm);">
        <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 700;">Total Store Revenue</div>
        <div style="font-size: 2rem; font-weight: 900; color: var(--text-main); margin-top: 0.25rem;">₹<%= totalRevenue %></div>
      </div>

      <div style="background: white; border-radius: var(--radius-md); padding: 1.5rem; border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm);">
        <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 700;">Active Kitchen Orders</div>
        <div style="font-size: 2rem; font-weight: 900; color: var(--dominos-red); margin-top: 0.25rem;"><%= pendingCount %></div>
      </div>

      <div style="background: white; border-radius: var(--radius-md); padding: 1.5rem; border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm);">
        <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 700;">Registered Customers</div>
        <div style="font-size: 2rem; font-weight: 900; color: var(--dominos-blue); margin-top: 0.25rem;"><%= usersCount %></div>
      </div>

      <div style="background: white; border-radius: var(--radius-md); padding: 1.5rem; border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm);">
        <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 700;">Active Menu Pizzas</div>
        <div style="font-size: 2rem; font-weight: 900; color: var(--text-main); margin-top: 0.25rem;"><%= pizzasCount %></div>
      </div>
    </div>

    <!-- Salesforce CRM Integration Readiness Card -->
    <div style="background: linear-gradient(135deg, #001e3d 0%, #003366 100%); color: white; border-radius: var(--radius-md); padding: 1.5rem 1.75rem; margin-bottom: 2.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; box-shadow: var(--shadow-md);">
      <div>
        <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.4rem;">
          <span style="font-size: 1.5rem;">☁️</span>
          <h3 style="font-size: 1.25rem; font-weight: 800; color: white;">Salesforce CRM Integration: <span style="color: #38bdf8;">Connected</span></h3>
        </div>
        <p style="color: #cbd5e1; font-size: 0.9rem; max-width: 650px; line-height: 1.5;">
          Target Org: <code>orgfarm-ab048a4b48-dev-ed.develop.lightning.force.com</code><br>
          Customer records map to <strong>Contact</strong> and Orders with line items map to <strong>Order</strong>.
        </p>
      </div>

      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <button id="btn-sf-sync" onclick="syncAllToSalesforce()" class="btn-dominos-red" style="padding: 0.6rem 1.25rem; font-size: 0.88rem; background: #0284c7; border: 1px solid #38bdf8;">
          ⚡ Sync All to Salesforce
        </button>
        <a href="https://orgfarm-ab048a4b48-dev-ed.develop.lightning.force.com/lightning/o/Contact/list" target="_blank" style="background: rgba(255,255,255,0.15); color: white; padding: 0.6rem 1rem; border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 700; border: 1px solid rgba(255,255,255,0.3); text-decoration: none;">
          Open Contacts in Salesforce ↗
        </a>
      </div>
    </div>

    <!-- Orders Live Management -->
    <div style="background: white; border-radius: var(--radius-lg); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm); overflow: hidden;">
      <div style="padding: 1.5rem; border-bottom: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 1.3rem; font-weight: 800;">Real-Time Order Queue (<%= orders.length %>)</h3>
        <button onclick="location.reload()" class="btn-dominos-blue" style="background: #f1f5f9; color: var(--text-main); border: 1px solid var(--border-subtle); padding: 0.45rem 1rem; border-radius: var(--radius-sm); font-size: 0.85rem; font-weight: 700; cursor: pointer;">
          🔄 Refresh Orders
        </button>
      </div>

      <% if (orders.length === 0) { %>
        <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
          No customer orders placed yet. Place an order in another tab to see it appear here!
        </div>
      <% } else { %>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead>
              <tr style="background: #f8fafc; border-bottom: 2px solid var(--border-subtle); font-size: 0.82rem; text-transform: uppercase; color: var(--text-muted);">
                <th style="padding: 1rem 1.25rem;">Order Details</th>
                <th style="padding: 1rem 1.25rem;">Customer & Phone</th>
                <th style="padding: 1rem 1.25rem;">Items</th>
                <th style="padding: 1rem 1.25rem;">Amount</th>
                <th style="padding: 1rem 1.25rem;">Update Live Status</th>
                <th style="padding: 1rem 1.25rem;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(order => { %>
                <tr style="border-bottom: 1px solid var(--border-subtle);">
                  <td style="padding: 1.25rem;">
                    <div style="font-weight: 800; color: var(--dominos-blue);">#<%= order.id %></div>
                    <div style="font-size: 0.78rem; color: var(--text-muted);"><%= new Date(order.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></div>
                  </td>

                  <td style="padding: 1.25rem;">
                    <div style="font-weight: 700;"><%= order.customerName %></div>
                    <div style="font-size: 0.8rem; color: var(--text-muted);"><%= order.customerPhone %></div>
                    <div style="font-size: 0.75rem; color: var(--text-light);"><%= order.address.area %>, <%= order.address.pincode %></div>
                  </td>

                  <td style="padding: 1.25rem;">
                    <% order.items.forEach(it => { %>
                      <div style="font-size: 0.85rem;"><strong><%= it.quantity %>x</strong> <%= it.name %> <span style="color: var(--text-muted); font-size: 0.78rem;">(<%= it.sizeName %>)</span></div>
                    <% }) %>
                  </td>

                  <td style="padding: 1.25rem;">
                    <div style="font-weight: 800; font-size: 1rem;">₹<%= order.pricing.grandTotal %></div>
                    <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;"><%= order.paymentMethod %></div>
                  </td>

                  <td style="padding: 1.25rem;">
                    <form action="/admin/orders/<%= order.id %>/status" method="POST" style="display: flex; gap: 0.5rem; align-items: center;">
                      <select name="status" class="form-control" style="padding: 0.4rem 0.6rem; font-size: 0.85rem; font-weight: 700; width: auto;" onchange="this.form.submit()">
                        <option value="order_placed" <%= order.status === 'order_placed' ? 'selected' : '' %>>1. Order Confirmed</option>
                        <option value="preparing" <%= order.status === 'preparing' ? 'selected' : '' %>>2. Preparing (Kitchen)</option>
                        <option value="baking" <%= order.status === 'baking' ? 'selected' : '' %>>3. Baking in Oven</option>
                        <option value="quality_check" <%= order.status === 'quality_check' ? 'selected' : '' %>>4. Quality Check</option>
                        <option value="out_for_delivery" <%= order.status === 'out_for_delivery' ? 'selected' : '' %>>5. Out for Delivery</option>
                        <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>6. Delivered</option>
                      </select>
                    </form>
                  </td>

                  <td style="padding: 1.25rem;">
                    <a href="/orders/track/<%= order.id %>" target="_blank" class="btn-dominos-blue" style="font-size: 0.8rem; padding: 0.4rem 0.8rem; background: #eff6ff; color: var(--dominos-blue); border: 1px solid #bfdbfe; border-radius: var(--radius-sm); font-weight: 700; display: inline-flex; align-items: center; gap: 0.3rem;">
                      <span>Live Tracker</span> ↗
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script>
    async function syncAllToSalesforce() {
      const btn = document.getElementById('btn-sf-sync');
      btn.disabled = true;
      btn.textContent = 'Syncing with Salesforce...';

      try {
        const res = await fetch('/admin/salesforce/sync-all', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        btn.disabled = false;
        btn.textContent = '⚡ Sync All to Salesforce';

        if (data.success) {
          showToast(`Synced ${data.customersAttempted} Customers & ${data.ordersAttempted} Orders to Salesforce format!`, 'success');
        } else {
          showToast('Sync completed with notice', 'info');
        }
      } catch (err) {
        btn.disabled = false;
        btn.textContent = '⚡ Sync All to Salesforce';
        console.error(err);
        showToast('Error triggering Salesforce sync', 'info');
      }
    }
  </script>
</body>
</html>
