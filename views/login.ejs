<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body style="background: #f1f5f9;">

  <!-- Global Header -->
  <%- include('partials/header') %>

  <main class="container" style="padding: 4rem 1.25rem; display: flex; justify-content: center; align-items: center; min-height: calc(100vh - 160px);">
    <div style="background: white; border-radius: var(--radius-lg); box-shadow: var(--shadow-xl); border: 1px solid var(--border-subtle); max-width: 440px; width: 100%; padding: 2.5rem 2.25rem;">
      
      <div style="text-align: center; margin-bottom: 2rem;">
        <div class="brand-logo" style="justify-content: center; font-size: 2rem; margin-bottom: 0.5rem;">
          <svg class="domino-icon-svg" viewBox="0 0 100 100" fill="none" style="width: 36px; height: 36px;">
            <rect x="8" y="24" width="46" height="46" rx="9" transform="rotate(-45 8 24)" fill="#0055a5"/>
            <rect x="42" y="-10" width="46" height="46" rx="9" transform="rotate(-45 42 -10)" fill="#e31837"/>
            <circle cx="50" cy="22" r="4.5" fill="white"/>
            <circle cx="38" cy="58" r="4" fill="white"/>
            <circle cx="62" cy="58" r="4" fill="white"/>
          </svg>
          <div>Domino's<span class="red">.</span></div>
        </div>
        <h2 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 0.25rem;">Welcome Back</h2>
        <p style="color: var(--text-muted); font-size: 0.92rem;">Sign in to access your orders, saved addresses, and express checkout.</p>
      </div>

      <% if (error) { %>
        <div style="background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; padding: 0.75rem 1rem; border-radius: var(--radius-md); font-size: 0.88rem; font-weight: 600; margin-bottom: 1.5rem;">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <form action="/login" method="POST">
        <input type="hidden" name="redirect" value="<%= redirect %>">

        <div class="form-group">
          <label class="form-label" for="login-email">Email Address</label>
          <input type="email" id="login-email" name="email" class="form-control" placeholder="name@example.com" required autofocus>
        </div>

        <div class="form-group" style="margin-bottom: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
            <label class="form-label" for="login-password" style="margin-bottom: 0;">Password</label>
            <a href="#" style="font-size: 0.8rem; color: var(--dominos-blue); font-weight: 600;">Forgot password?</a>
          </div>
          <input type="password" id="login-password" name="password" class="form-control" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn-dominos-red" style="width: 100%; justify-content: center; font-size: 1.05rem; padding: 0.85rem;">
          Sign In
        </button>
      </form>

      <!-- Instant 1-Click Demo Fill -->
      <div class="quick-demo-login-box">
        <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.25rem;">Demo Credentials</div>
        <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem;">Email: <code>demo@dominos.com</code> | Password: <code>password123</code></div>
        <button type="button" class="quick-demo-btn" onclick="document.getElementById('login-email').value='demo@dominos.com'; document.getElementById('login-password').value='password123'; showToast('Filled demo credentials! Click Sign In', 'info');">
          ⚡ Auto-Fill Demo Account
        </button>
      </div>

      <div style="text-align: center; margin-top: 1.75rem; font-size: 0.92rem; color: var(--text-muted);">
        Don't have a Domino's account yet?
        <a href="/register<%= redirect ? `?redirect=${encodeURIComponent(redirect)}` : '' %>" style="color: var(--dominos-blue); font-weight: 700;">Create Account</a>
      </div>

    </div>
  </main>

  <%- include('partials/cart-drawer') %>
  <%- include('partials/customize-modal') %>
  <%- include('partials/auth-modal') %>
  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script src="/js/cart.js"></script>
  <script src="/js/auth-modal.js"></script>
</body>
</html>
