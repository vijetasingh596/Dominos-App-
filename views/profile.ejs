<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body style="background: #f8fafc;">

  <!-- Global Header -->
  <%- include('partials/header') %>

  <div style="background: white; border-bottom: 1px solid var(--border-subtle); padding: 2.25rem 0;">
    <div class="container">
      <div style="display: flex; align-items: center; gap: 1.25rem;">
        <div class="user-avatar-circle" style="width: 64px; height: 64px; font-size: 1.75rem;">
          <%= user.name.charAt(0).toUpperCase() %>
        </div>
        <div>
          <h1 style="font-size: 2rem; font-weight: 900; margin-bottom: 0.2rem;"><%= user.name %></h1>
          <p style="color: var(--text-muted); font-size: 0.95rem;"><%= user.email %> • <%= user.phone %></p>
        </div>
      </div>
    </div>
  </div>

  <main class="container" style="padding-top: 2.5rem; padding-bottom: 5rem;">
    <% if (successMsg) { %>
      <div style="background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; padding: 0.85rem 1.25rem; border-radius: var(--radius-md); font-weight: 600; margin-bottom: 2rem;">
        ✓ <%= successMsg %>
      </div>
    <% } %>

    <div style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 2.5rem;">
      <!-- Saved Addresses -->
      <div>
        <div style="background: white; border-radius: var(--radius-lg); padding: 2rem; border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm); margin-bottom: 2rem;">
          <h3 style="font-size: 1.3rem; font-weight: 800; margin-bottom: 1.25rem;">Saved Delivery Addresses</h3>

          <% if (user.addresses && user.addresses.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.75rem;">
              <% user.addresses.forEach(addr => { %>
                <div style="padding: 1rem 1.25rem; border: 1.5px solid var(--border-subtle); border-radius: var(--radius-md); background: #f8fafc; display: flex; justify-content: space-between; align-items: center;">
                  <div>
                    <span style="font-size: 0.75rem; font-weight: 800; text-transform: uppercase; background: var(--dominos-blue); color: white; padding: 0.2rem 0.5rem; border-radius: 4px;"><%= addr.type %></span>
                    <div style="font-weight: 700; font-size: 0.95rem; margin-top: 0.4rem;"><%= addr.flat %></div>
                    <div style="font-size: 0.85rem; color: var(--text-muted);"><%= addr.area %>, <%= addr.city %> - <%= addr.pincode %></div>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">No saved addresses yet. Add one below for faster checkout.</p>
          <% } %>

          <h4 style="font-size: 1.05rem; font-weight: 800; margin-bottom: 1rem;">Add New Address</h4>
          <form action="/profile/address" method="POST">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div class="form-group">
                <label class="form-label" for="new-type">Type</label>
                <select id="new-type" name="type" class="form-control">
                  <option value="Home">Home</option>
                  <option value="Work">Work</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="new-flat">Flat / House No.</label>
                <input type="text" id="new-flat" name="flat" class="form-control" placeholder="Flat 204" required>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="new-area">Area / Street</label>
              <input type="text" id="new-area" name="area" class="form-control" placeholder="Indiranagar" required>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div class="form-group">
                <label class="form-label" for="new-city">City</label>
                <input type="text" id="new-city" name="city" class="form-control" value="Bengaluru" required>
              </div>
              <div class="form-group">
                <label class="form-label" for="new-pin">Pincode</label>
                <input type="text" id="new-pin" name="pincode" class="form-control" placeholder="560038" required>
              </div>
            </div>

            <button type="submit" class="btn-dominos-blue" style="background: var(--dominos-blue); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: var(--radius-md); font-weight: 700; cursor: pointer;">
              Save Address
            </button>
          </form>
        </div>
      </div>

      <!-- Quick Summary -->
      <div>
        <div style="background: white; border-radius: var(--radius-lg); padding: 2rem; border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm);">
          <h3 style="font-size: 1.3rem; font-weight: 800; margin-bottom: 1.25rem;">Account Overview</h3>

          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <div style="display: flex; justify-content: space-between; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-subtle);">
              <span style="color: var(--text-muted);">Total Orders:</span>
              <strong style="color: var(--text-main);"><%= ordersCount %></strong>
            </div>
            <div style="display: flex; justify-content: space-between; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-subtle);">
              <span style="color: var(--text-muted);">Member Since:</span>
              <strong style="color: var(--text-main);"><%= new Date(user.createdAt || Date.now()).toLocaleDateString() %></strong>
            </div>
            <div style="display: flex; justify-content: space-between; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-subtle);">
              <span style="color: var(--text-muted);">Domino's Cheesy Points:</span>
              <strong style="color: var(--dominos-red);">450 Pts 🍕</strong>
            </div>
          </div>

          <div style="margin-top: 1.5rem;">
            <a href="/orders" class="btn-dominos-red" style="width: 100%; justify-content: center; font-size: 0.95rem;">
              View My Order History
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/cart-drawer') %>
  <%- include('partials/customize-modal') %>
  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
  <script src="/js/cart.js"></script>
</body>
</html>
